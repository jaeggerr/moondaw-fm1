pat t6 00 len 64
02 E-5 i07
0E C-5
12 C-5
1E A-4
22 E-5
2E G-4
32 D-5
3E B-4

pat t7 00 len 16
08 C-4 i03

pat t7 01 len 16
08 C-4 i03
0E C-4

arr 00 steps auto
t4 00
t5 00
t6 00

arr 01 steps auto
t0 00
t2 00
t3 00
t4 00
t5 00
t6 00

arr 02 steps auto
t0 00
t1 00
t2 00
