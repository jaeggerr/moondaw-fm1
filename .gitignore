build/
*.dSYM/
moondaw-fm1.flash
# a crash of the emulated toolchain leaves a file named core at the root;
# core/ the directory is the tracker
/core
!/core/

# the listening demos are kept as .mp3; the .wav the generators write
# (tools/drums/drums.py, tests/fm_render.c) stays out of the repository
docs/**/*.wav

# the session folder of the editor (worktrees, local settings)
/.claude/

# what the python in tools/ leaves behind when it is imported
tools/__pycache__/
